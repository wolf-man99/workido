# =============================================================================
# Workido environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Full reference: docs/ENVIRONMENT.md
# =============================================================================

# --- Required --------------------------------------------------------------
# Public URL of this app (used for auth email links and metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and public key (Project Settings -> API).
# Either the legacy "anon" JWT key or the new "publishable" key (sb_publishable_...) works.
# These are public by design and protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server-only secrets ---------------------------------------------------
# Service role / secret key. REQUIRED for payments (verification + webhooks)
# and email dispatch. Bypasses RLS: keep it server-side only. Never prefix
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments --------------------------------------------------------------
# "razorpay" for live/test Razorpay, "dev" for the clearly-labelled local
# development adapter (no real money). Leave empty to disable checkout.
PAYMENT_PROVIDER=dev
# Secret used to sign development payment confirmations (any long random string).
DEV_PAYMENTS_SECRET=change-me-to-a-long-random-string
# The dev adapter refuses to run when NODE_ENV=production unless this is "true"
# (e.g. for a private staging demo). A "test mode" banner is always shown.
ALLOW_DEV_PAYMENTS=

# Razorpay (Dashboard -> Account & Settings -> API Keys / Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email notifications (optional) -----------------------------------------
# Resend API key and verified sender. Without these, emails are logged in
# development and skipped in production; in-app notifications always work.
RESEND_API_KEY=
EMAIL_FROM="Workido <notifications@yourdomain.com>"

# Protects /api/notifications/dispatch (send as "Authorization: Bearer <secret>").
CRON_SECRET=

# --- Optional branding / support ----------------------------------------------
# The brand tagline is NOT finalised. Leave empty until one is approved.
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Social links are only rendered when set. Do not invent URLs.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=

# Timezone used to interpret requirement deadlines entered as dates.
APP_TIMEZONE=Asia/Kolkata
